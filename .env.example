# Cloud Breaker (Orbiton Hackathon - Open Innovation)
# Root Environment Configuration

# Backend Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# STAC Satellite Imagery Configuration
# Default: Microsoft Planetary Computer STAC API (Public Sentinel-2 L2A COGs)
STAC_CATALOG_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# Optional: Set your Planetary Computer API key if you require higher rate limits
PC_SDK_SUBSCRIPTION_KEY=

# Frontend Configuration (Used when building or running frontend)
VITE_API_URL=http://127.0.0.1:8000
